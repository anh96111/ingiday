{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "ingiday-order-intake-consumer",
  "main": "index.ts",
  "compatibility_date": "2026-07-28",
  "vars": {
    "SUPABASE_URL": "REPLACE_WITH_SUPABASE_URL"
  },
  "d1_databases": [
    {
      "binding": "ORDER_INTAKE_DB",
      "database_name": "ingiday-order-intake",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ],
  "queues": {
    "consumers": [
      {
        "queue": "ingiday-order-intake",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 10,
        "dead_letter_queue": "ingiday-order-intake-dlq"
      }
    ]
  },
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  }
}
