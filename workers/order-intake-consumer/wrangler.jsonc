{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "ingiday-order-intake-consumer",
  "main": "index.ts",
  "compatibility_date": "2026-07-28",
  "workers_dev": false,
  "vars": {
    "SUPABASE_URL": "https://zucfgprjmfvdspnxfknq.supabase.co"
  },
  "secrets": {
    "required": [
      "SUPABASE_SERVER_KEY"
    ]
  },
  "d1_databases": [
    {
      "binding": "ORDER_INTAKE_DB",
      "database_name": "ingiday-order-intake",
      "database_id": "0cc976fb-062a-45a7-988c-e57335f9bcea"
    }
  ],
  "queues": {
    "consumers": [
      {
        "queue": "ingiday-order-intake",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 10,
        "dead_letter_queue": "ingiday-order-intake-dlq"
      }
    ]
  },
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  }
}
